<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F0B418" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:top="2.5dp"
        android:bottom="2.5dp"
        android:left="1.5dp"
        android:right="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#04194E"
                android:centerColor="#073D91"
                android:endColor="#031645"
                android:type="linear" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
